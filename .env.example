# PostgreSQL
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT
JWT_SECRET=remplacez_par_une_chaine_aleatoire_longue

# Frontend autorisé par CORS
FRONTEND_URL=https://votre-frontend.vercel.app

# Autoriser aussi les URLs de preview *.vercel.app (optionnel)
ALLOW_VERCEL_PREVIEWS=false

# Cloudinary - stockage persistant des avatars
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PostgreSQL pool serverless
PG_POOL_MAX=3

NODE_ENV=production
