{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "**/*.js": {
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/inactivity",
      "schedule": "0 7 * * *"
    }
  ]
}
